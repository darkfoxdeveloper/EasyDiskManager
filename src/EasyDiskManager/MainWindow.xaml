<Window x:Class="EasyDiskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:EasyDiskManager.Converters"
        Title="Easy Disk Manager" Width="1260" Height="820" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:SegmentWidthConverter x:Key="SegmentWidthConverter" />
        <conv:SegmentBrushConverter x:Key="SegmentBrushConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource PrimaryBrush}" Width="34" Height="34" CornerRadius="9" Margin="0,0,11,0">
                            <TextBlock Text="◫" Foreground="White" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Easy Disk Manager" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Particiones claras, cambios bajo control" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻  Actualizar" Command="{Binding RefreshCommand}" />
                    <Button Content="Deshacer" Command="{Binding UndoCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Margin="0" Command="{Binding ApplyCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Aplicar cambios" />
                            <Border Background="#35FFFFFF" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding PendingCount}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- Lista de discos -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="DISCOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="18,18,18,10" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}"
                             BorderThickness="0" Background="Transparent" Padding="8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EDF0FF" /></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#F2F4F8" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="8" Background="#E7EAF2" VerticalAlignment="Top">
                                        <TextBlock Text="▰" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#536078" FontSize="17" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse Width="6" Height="6" Fill="#38AE77" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding HealthText}" Foreground="#368765" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14">
                        <Button Content="＋  Nuevo volumen" Command="{Binding CreateCommand}" HorizontalAlignment="Stretch" Margin="0" />
                    </Border>
                </Grid>
            </Border>

            <!-- Centro -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" MaxHeight="190" />
                </Grid.RowDefinitions>

                <!-- Mapa del disco -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedDisk.DisplayName}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedDisk.Description}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#EAF8F1" CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDisk.HealthText}" Foreground="#268159" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <ScrollViewer x:Name="SegmentScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,18,0,0">
                            <ItemsControl ItemsSource="{Binding SelectedDisk.Segments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="76" Margin="0,0,5,0" CornerRadius="7" BorderBrush="#DDE1EA" BorderThickness="1" Background="#FAFBFD">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource SegmentWidthConverter}">
                                                    <Binding Path="Size" />
                                                    <Binding Path="DataContext.SelectedDisk.Size" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    <Binding Path="ActualWidth" ElementName="SegmentScroller" />
                                                </MultiBinding>
                                            </Border.Width>
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                <Border Background="{Binding Partition, Converter={StaticResource SegmentBrushConverter}}" CornerRadius="7,7,0,0" />
                                                <StackPanel Grid.Row="1" Margin="9,7" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Tabla -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,10">
                    <DataGrid ItemsSource="{Binding Partitions}" SelectedItem="{Binding SelectedPartition}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VOLUMEN" Binding="{Binding VolumeName}" Width="*" MinWidth="130" />
                            <DataGridTextColumn Header="LETRA" Binding="{Binding LetterText}" Width="65" />
                            <DataGridTextColumn Header="SISTEMA" Binding="{Binding FileSystemText}" Width="95" />
                            <DataGridTextColumn Header="CAPACIDAD" Binding="{Binding SizeText}" Width="95" />
                            <DataGridTextColumn Header="USADO" Binding="{Binding UsedText}" Width="90" />
                            <DataGridTextColumn Header="LIBRE" Binding="{Binding FreeText}" Width="90" />
                            <DataGridTextColumn Header="USO" Binding="{Binding UsedPercentText}" Width="58" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Cola -->
                <Border Grid.Row="4" Padding="14">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="OPERACIONES PENDIENTES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <Button Content="Vaciar" Command="{Binding ClearCommand}" HorizontalAlignment="Right" Padding="9,3" Margin="0" />
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding PendingOperations}" BorderThickness="0" Margin="0,7,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Border Width="24" Height="24" Background="#EDF0FF" CornerRadius="6" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Icon}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Acciones -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="ACCIONES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding SelectionTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,2" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectionDetails}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <Button Command="{Binding ResizeCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="↔" FontSize="17" Width="30" /><TextBlock Text="Redimensionar" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Command="{Binding ChangeLetterCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="A:" FontWeight="Bold" Width="30" /><TextBlock Text="Cambiar letra" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Command="{Binding RenameCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="✎" FontSize="16" Width="30" /><TextBlock Text="Cambiar etiqueta" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Command="{Binding FormatCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="↻" FontSize="17" Width="30" /><TextBlock Text="Formatear" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="×" FontSize="19" Width="30" /><TextBlock Text="Eliminar partición" VerticalAlignment="Center" /></StackPanel>
                    </Button>

                    <Border Background="#FFF8E8" BorderBrush="#F2E2AF" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Protección activa" FontWeight="SemiBold" Foreground="#856719" />
                            <TextBlock Text="Las acciones peligrosas se deshabilitan en particiones del sistema, arranque, recuperación u ocultas." TextWrapping="Wrap" FontSize="11" Foreground="#856719" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Capa de carga -->
            <Border Grid.ColumnSpan="5" Background="#55FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◌" Foreground="{StaticResource PrimaryBrush}" FontSize="22" Margin="0,0,10,0" />
                        <TextBlock Text="Procesando…" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- Estado -->
        <Border Grid.Row="2" Background="#EEF1F6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#38AE77" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
                <TextBlock Text="Windows Storage API · Los cambios no se ejecutan hasta pulsar Aplicar" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#9299AA" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
